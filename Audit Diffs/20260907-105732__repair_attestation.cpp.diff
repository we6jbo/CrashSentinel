+static qint64 monotonicMillisSinceBoot()
+{
+    QFile f(QStringLiteral("/proc/uptime"));
+    if (!f.open(QIODevice::ReadOnly))
+        return -1;
+
+    const QByteArray first = f.readLine().split(' ').value(0);
+    bool ok = false;
+    const double seconds = first.toDouble(&ok);
+    return ok ? qint64(seconds * 1000.0) : -1;
+}

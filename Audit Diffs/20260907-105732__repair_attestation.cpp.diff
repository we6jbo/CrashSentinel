+QByteArray RepairAttestation::loadOrCreateSecret(const QString &stateDir,
+                                                 QString *errorMessage)
+{
+    const QString path = QDir(stateDir).filePath(QStringLiteral("repair-attestation.key"));
+
+    QFile existing(path);
+    if (existing.open(QIODevice::ReadOnly)) {
+        const QByteArray encoded = existing.readAll().trimmed();
+        const QByteArray decoded = QByteArray::fromHex(encoded);
+        if (decoded.size() == 32)
+            return decoded;
+    }
+
+    QByteArray secret(32, '\0');
+    for (int i = 0; i < 32; i += 8) {
+        const quint64 r = QRandomGenerator::system()->generate64();
+        for (int j = 0; j < 8 && i + j < 32; ++j)
+            secret[i + j] = char((r >> (j * 8)) & 0xff);
+    }
+
+    QSaveFile out(path);
+    if (!out.open(QIODevice::WriteOnly)) {
+        if (errorMessage)
+            *errorMessage = QStringLiteral("Could not create attestation key: %1")
+                                .arg(out.errorString());
+        return {};
+    }
+    out.write(secret.toHex());
+    out.write("\n");
+    if (!out.commit()) {
+        if (errorMessage)
+            *errorMessage = QStringLiteral("Could not commit attestation key.");
+        return {};
+    }
+
+    QFile::setPermissions(path, QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+    return secret;
+}

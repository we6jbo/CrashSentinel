+QString RecoveryDiagnostics::createBackup(const QString &stateDir,
+                                          QString *error)
+{
+    QString base =
+        QStandardPaths::writableLocation(
+            QStandardPaths::DocumentsLocation);
+
+    if (base.isEmpty())
+        base = QDir::homePath();
+
+    const QString backupDir =
+        QDir(base).filePath(
+            QStringLiteral("CrashSentinel-Recovery-Backup"));
+
+    if (!QDir().mkpath(backupDir)) {
+        if (error)
+            *error = QStringLiteral(
+                "Could not create backup directory.");
+        return {};
+    }
+
+    const QStringList files = {
+        QStringLiteral("self-protection.json"),
+        QStringLiteral("service-health.json"),
+        QStringLiteral("repair-readiness.json"),
+        QStringLiteral("latest-snapshot.txt"),
+        QStringLiteral("reports/previous-boot-analysis.txt"),
+        QStringLiteral("reports/analysis-boot-id.txt")
+    };
+
+    QStringList manifest;
+    manifest << QStringLiteral("#ju56Us");
+    manifest << QStringLiteral("CrashSentinel recovery backup");
+    manifest << QStringLiteral("Source state directory: %1")
+                    .arg(stateDir);
+
+    for (const QString &relative : files) {
+        const QString src = QDir(stateDir).filePath(relative);
+
+        if (!QFileInfo::exists(src)) {
+            manifest << QStringLiteral("MISSING: %1").arg(relative);
+            continue;
+        }
+
+        QString safeName = relative;
+        safeName.replace('/', QStringLiteral("__"));
+
+        const QString dst =
+            QDir(backupDir).filePath(safeName);
+
+        QFile::remove(dst);
+
+        if (QFile::copy(src, dst))
+            manifest << QStringLiteral("COPIED: %1").arg(relative);
+        else
+            manifest << QStringLiteral("FAILED: %1").arg(relative);
+    }
+
+    QFile mf(
+        QDir(backupDir).filePath(
+            QStringLiteral("backup-manifest.txt")));
+
+    if (mf.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        QTextStream ts(&mf);
+        ts << manifest.join(QStringLiteral("\n")) << '\n';
+    }
+
+    return backupDir;
+}

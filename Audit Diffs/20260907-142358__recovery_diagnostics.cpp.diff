+bool RecoveryDiagnostics::rebuildDerivedReportMarker(
+    const QString &stateDir,
+    QString *error)
+{
+    const QString marker =
+        QDir(stateDir).filePath(
+            QStringLiteral("reports/analysis-boot-id.txt"));
+
+    if (!QFileInfo::exists(marker))
+        return true;
+
+    if (!QFile::remove(marker)) {
+        if (error)
+            *error = QStringLiteral(
+                "Could not remove the previous-boot analysis marker.");
+        return false;
+    }
+
+    return true;
+}

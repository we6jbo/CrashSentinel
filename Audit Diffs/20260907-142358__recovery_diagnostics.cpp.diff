+static QString readTextFile(const QString &path)
+{
+    QFile f(path);
+    if (!f.open(QIODevice::ReadOnly))
+        return {};
+    return QString::fromUtf8(f.readAll());
+}
+
+static bool writeJsonObject(const QString &path,
+                            const QJsonObject &object,
+                            QString *error)
+{
+    QSaveFile f(path);
+
+    if (!f.open(QIODevice::WriteOnly)) {
+        if (error)
+            *error = f.errorString();
+        return false;
+    }
+
+    f.write(QJsonDocument(object).toJson(QJsonDocument::Indented));
+
+    if (!f.commit()) {
+        if (error)
+            *error = QStringLiteral("Could not commit updated state file.");
+        return false;
+    }
+
+    return true;
+}
+
+static QStringList crashSentinelProcessLines()
+{
+    QProcess p;
+    p.start(QStringLiteral("pgrep"),
+            {QStringLiteral("-af"), QStringLiteral("CrashSentinel")});
+
+    if (!p.waitForStarted(1000))
+        return {};
+
+    if (!p.waitForFinished(2500)) {
+        p.kill();
+        p.waitForFinished(500);
+        return {};
+    }
+
+    const QString output =
+        QString::fromUtf8(p.readAllStandardOutput()).trimmed();
+
+    if (output.isEmpty())
+        return {};
+
+    return output.split('\n', Qt::SkipEmptyParts);
+}

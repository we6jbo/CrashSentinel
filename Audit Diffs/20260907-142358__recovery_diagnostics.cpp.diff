+        QDir(base).filePath(
+            QStringLiteral("CrashSentinel-Diagnostic-Report.txt"));
+
+    QSaveFile f(output);
+
+    if (!f.open(QIODevice::WriteOnly)) {
+        if (error)
+            *error = f.errorString();
+        return {};
+    }
+
+    QTextStream ts(&f);
+    const auto status = inspect(stateDir);
+
+    ts << "#ju56Us\n";
+    ts << "CrashSentinel Diagnostic Report\n\n";
+    ts << status.details << "\n\n";
+
+    const QStringList files = {
+        QStringLiteral("service-health.json"),
+        QStringLiteral("self-protection.json"),
+        QStringLiteral("repair-readiness.json"),
+        QStringLiteral("reports/previous-boot-analysis.txt")
+    };
+
+    for (const QString &relative : files) {
+        ts << "===== " << relative << " =====\n";

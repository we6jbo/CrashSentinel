+bool RecoveryDiagnostics::clearSelfQuarantine(const QString &stateDir,
+                                              QString *error)
+{
+    const QString path =
+        QDir(stateDir).filePath(QStringLiteral("self-protection.json"));
+
+    QFile f(path);
+    if (!f.open(QIODevice::ReadOnly)) {
+        if (error)
+            *error = QStringLiteral(
+                "self-protection.json could not be opened.");
+        return false;
+    }
+
+    const QJsonDocument doc = QJsonDocument::fromJson(f.readAll());
+    if (!doc.isObject()) {
+        if (error)
+            *error = QStringLiteral(
+                "self-protection.json is not valid JSON.");
+        return false;
+    }
+
+    QJsonObject o = doc.object();
+    o.insert(QStringLiteral("_audit_tag"), QStringLiteral("#ju56Us"));
+    o.insert(QStringLiteral("quarantined"), false);
+    o.insert(QStringLiteral("rapid_failures"), 0);
+    o.insert(QStringLiteral("reason"), QString());
+    o.insert(QStringLiteral("run_state"),
+             QStringLiteral("cleared-by-recovery-ui"));
+
+    return writeJsonObject(path, o, error);
+}

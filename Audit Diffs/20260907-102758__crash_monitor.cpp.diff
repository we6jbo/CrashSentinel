+CrashMonitor::CrashMonitor(QObject *parent) : QObject(parent)
+{
+    timer_.setInterval(20000);
+    connect(&timer_, &QTimer::timeout, this, &CrashMonitor::collect);
+}
+
+QString CrashMonitor::stateDir() const
+{
+    // Development mode: user-owned persistent state.
+    // A packaged daemon can override this later with CRASHSENTINEL_STATE_DIR.
+    const QString overrideDir = qEnvironmentVariable("CRASHSENTINEL_STATE_DIR");
+    if (!overrideDir.trimmed().isEmpty())
+        return overrideDir;
+
+    QString base = QStandardPaths::writableLocation(QStandardPaths::StateLocation);
+    if (base.isEmpty())
+        base = QDir::homePath() + QStringLiteral("/.local/state/CrashSentinel");
+
+    return base;
+}
+
+QString CrashMonitor::run(const QString &program, const QStringList &args, int timeoutMs) const
+{
+    QProcess p;
+    p.start(program, args);
+    if (!p.waitForStarted(1500))
+        return QStringLiteral("[unavailable]\n");
+
+    if (!p.waitForFinished(timeoutMs)) {
+        p.kill();
+        p.waitForFinished(1000);
+        return QStringLiteral("[timed out]\n");
+    }
+
+    return QString::fromUtf8(p.readAllStandardOutput()) +
+           QString::fromUtf8(p.readAllStandardError());
+}
+
+bool CrashMonitor::writeAtomic(const QString &path, const QByteArray &data) const
+{
+    QSaveFile f(path);
+    if (!f.open(QIODevice::WriteOnly))
+        return false;
+    f.write(data);
+    return f.commit();
+}
+
+bool CrashMonitor::start()
+{
+    const QString dir = stateDir();
+    if (!QDir().mkpath(dir))
+        return false;
+
+    collect();
+    timer_.start();
+    return true;
+}

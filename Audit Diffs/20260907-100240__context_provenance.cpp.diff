+QString ContextProvenance::userVisibleContextSummary(const MachineContext &c) {
+    if(!c.valid) return "Machine context unavailable.";
+    QStringList x;
+    if(!c.date.isEmpty()) x<<"Date: "+c.date;
+    if(!c.weekday.isEmpty()) x<<"Weekday: "+c.weekday;
+    if(!c.timezone.isEmpty()) x<<"Timezone: "+c.timezone;
+    if(!c.locationLabel.isEmpty()) x<<"Location: "+c.locationLabel;
+    if(c.timeVisible && !c.timeDisplay.isEmpty())
+        x<<"Time: "+c.timeDisplay+(c.timePolicy.isEmpty()?"":" ("+c.timePolicy+")");
+    else
+        x<<"Time: hidden by context policy";
+    return x.join('\n');
+}

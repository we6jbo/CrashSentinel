+bool ContextProvenance::ensurePortableSnapshot(const QString &root, QString *err) {
+    QJsonObject o;
+    o["schema"]=1; o["project_id"]=ProjectId; o["project_name"]=ProjectName;
+    QJsonArray ids; ids.append(ProvenanceCode); o["identifiers"]=ids;
+    o["reference"]="User-supplied TG / AKA portable provenance contract";
+    o["portable"]=true; o["private_registry_required"]=false;
+    o["scope"]="Apply provenance only to artifacts, logs, GUI metadata, and communications created by CrashSentinel itself.";
+    o["registry_note"]="Normal operation does not require /home/we6jbo/.sstages/tg/tg_registry.db";
+
+    QSaveFile f(QDir(root).filePath("tg_context_snapshot.json"));
+    if(!f.open(QIODevice::WriteOnly)){ if(err)*err=f.errorString(); return false; }
+    f.write(QJsonDocument(o).toJson(QJsonDocument::Indented));
+    if(!f.commit()){ if(err)*err=f.errorString(); return false; }
+    return true;
+}

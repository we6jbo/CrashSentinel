+MachineContext ContextProvenance::loadMachineContext() {
+    MachineContext c; c.sourcePath=contextPath();
+    QFile f(c.sourcePath); if(!f.open(QIODevice::ReadOnly)) return c;
+    QJsonParseError pe; auto d=QJsonDocument::fromJson(f.readAll(),&pe);
+    if(pe.error!=QJsonParseError::NoError || !d.isObject()) return c;
+
+    auto o=d.object(); c.schema=o.value("schema").toInt();
+    c.generatedAt=s(o,"generated_at"); c.date=s(o,"date"); c.weekday=s(o,"weekday");
+    c.timezone=s(o,"timezone"); c.locationLabel=s(o,"location_label");
+    auto t=o.value("time").toObject();
+    c.timeVisible=t.value("visible").toBool(false);
+    c.timePolicy=s(t,"policy");
+    c.timeDisplay=c.timeVisible?s(t,"display"):QString(); // enforce hidden-time policy
+    c.valid=true;
+    return c;
+}

+QString ContextProvenance::generatedArtifactMetadata(const MachineContext &c) {
+    QStringList x;
+    x<<"project_id="+QString(ProjectId)<<"project_name="+QString(ProjectName)
+     <<"provenance_code="+QString(ProvenanceCode);
+    if(c.valid) {
+        if(!c.date.isEmpty()) x<<"context_date="+c.date;
+        if(!c.weekday.isEmpty()) x<<"context_weekday="+c.weekday;
+        if(!c.timezone.isEmpty()) x<<"context_timezone="+c.timezone;
+        if(!c.locationLabel.isEmpty()) x<<"context_location="+c.locationLabel;
+        x<<QString("context_time_visible=%1").arg(c.timeVisible?"true":"false");
+        if(c.timeVisible && !c.timeDisplay.isEmpty()) x<<"context_time_display="+c.timeDisplay;
+        if(!c.timePolicy.isEmpty()) x<<"context_time_policy="+c.timePolicy;
+    }
+    return x.join('\n');
+}

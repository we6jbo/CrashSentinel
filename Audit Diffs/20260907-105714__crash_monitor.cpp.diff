+void CrashMonitor::analyzePreviousBootOnce()
+{
+    const QString reportsDir =
+        QDir(stateDir()).filePath(QStringLiteral("reports"));
+    QDir().mkpath(reportsDir);
+
+    const QString bootId = readFile(QStringLiteral("/proc/sys/kernel/random/boot_id")).trimmed();
+    const QString marker =
+        QDir(reportsDir).filePath(QStringLiteral("analysis-boot-id.txt"));
+
+    if (readFile(marker).trimmed() == bootId)
+        return;
+
+    const QString report = previousBootAnalysis();
+    writeAtomic(QDir(reportsDir).filePath(
+                    QStringLiteral("previous-boot-analysis.txt")),
+                report.toUtf8());
+    writeAtomic(marker, (bootId + "\n").toUtf8());
+}
